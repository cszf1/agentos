{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:app-bundle:v1",
  "title": "AgentOS declarative application bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "manifest", "data", "view"],
  "properties": {
    "formatVersion": { "const": 1 },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "title", "runtime", "capabilities"],
      "properties": {
        "appId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 512 },
        "runtime": { "const": "declarative-v1" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["records.read", "records.write"] },
          "contains": { "const": "records.read" }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/fieldKey" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "titleField", "columns", "formFields", "filters"],
      "properties": {
        "kind": { "const": "records" },
        "titleField": { "$ref": "#/$defs/fieldKey" },
        "columns": { "$ref": "#/$defs/fieldList" },
        "formFields": { "$ref": "#/$defs/fieldList" },
        "searchField": { "$ref": "#/$defs/fieldKey" },
        "filters": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldKey" }
        }
      }
    }
  },
  "$defs": {
    "fieldKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "not": { "enum": ["constructor", "prototype", "__proto__"] }
    },
    "fieldList": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/fieldKey" }
    },
    "field": {
      "oneOf": [
        { "$ref": "#/$defs/stringField" },
        { "$ref": "#/$defs/booleanField" },
        { "$ref": "#/$defs/integerField" },
        { "$ref": "#/$defs/enumField" }
      ]
    },
    "stringField": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "label", "maxLength"],
      "properties": {
        "type": { "const": "string" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "default": { "type": "string", "maxLength": 4096 }
      }
    },
    "booleanField": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "boolean" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "default": { "type": "boolean" }
      }
    },
    "integerField": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": { "const": "integer" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "minimum": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "maximum": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "default": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
      }
    },
    "enumField": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "label", "values"],
      "properties": {
        "type": { "const": "enum" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "values": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "default": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
