{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "paths": { "@agentos/contracts": ["../contracts/src/index.ts"] }
  },
  "include": ["src"]
}
