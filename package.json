{
  "name": "agentos",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "typecheck": "tsc -b packages/host && tsc -p packages/app-sdk && tsc -p packages/app-runner && tsc -p tests/tsconfig.json --noEmit && pnpm --filter @agentos/web typecheck",
    "build": "tsc -b packages/host && tsc -p packages/app-sdk && tsc -p packages/app-runner && pnpm --filter @agentos/web build",
    "dev": "node scripts/dev.mjs",
    "start": "bin/agentos-host",
    "test": "pnpm build && vitest run --project unit",
    "test:recovery": "pnpm build && vitest run --project recovery",
    "test:e2e": "pnpm build && playwright test -c tests/e2e/playwright.config.ts",
    "smoke:real": "pnpm build && node scripts/smoke-real.mjs",
    "backup": "bin/agentos-admin backup",
    "restore": "bin/agentos-admin restore",
    "runtime:catalog": "pnpm build && node scripts/runtime-catalog.mjs",
    "runtime:doctor": "bin/agentos-runtime doctor",
    "runtime:prefetch": "bin/agentos-runtime prefetch",
    "runtime:gc": "bin/agentos-admin gc",
    "test:sandbox": "pnpm build && vitest run --project sandbox",
    "smoke:v0.2-real": "pnpm build && node scripts/smoke-v02-real.mjs",
    "native:build": "node scripts/native-build.mjs",
    "native:doctor": "node scripts/native-doctor.mjs",
    "test:native": "pnpm build && vitest run --project native",
    "test:broker-recovery": "pnpm build && vitest run --project broker-recovery",
    "test:telemetry": "pnpm build && vitest run --project telemetry",
    "smoke:v0.3-real": "pnpm build && node scripts/smoke-v03-real.mjs",
    "contracts:check": "node scripts/export-contracts.mjs --check && node scripts/protocol-vectors.mjs --check",
    "agents:doctor": "node scripts/agents-doctor.mjs",
    "maintenance:doctor": "node scripts/maintenance-doctor.mjs",
    "test:maintenance-recovery": "pnpm build && vitest run --project maintenance-recovery",
    "test:agents": "vitest run --project agents",
    "test:maintenance": "vitest run --project maintenance",
    "test:gc-online": "vitest run --project gc-online",
    "test:compaction": "vitest run --project compaction"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
