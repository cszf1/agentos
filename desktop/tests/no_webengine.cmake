# V1-D01: the Shell binary must not link (directly or transitively) Qt WebEngine / WebView or any browser engine,
# and the build must not have found those packages.
if(NOT EXISTS "${BIN}")
  message(FATAL_ERROR "missing binary ${BIN}")
endif()
find_program(LDD ldd)
find_program(READELF readelf)
set(deps "")
if(READELF)
  execute_process(COMMAND ${READELF} -d ${BIN} OUTPUT_VARIABLE needed RESULT_VARIABLE rc)
  string(APPEND deps "${needed}")
endif()
if(LDD)
  execute_process(COMMAND ${LDD} ${BIN} OUTPUT_VARIABLE linked RESULT_VARIABLE rc2)
  string(APPEND deps "${linked}")
endif()
if(deps STREQUAL "")
  message(FATAL_ERROR "could not inspect ${BIN} (no readelf/ldd)")
endif()
foreach(bad WebEngine WebView webkit chromium Chromium libcef electron)
  string(FIND "${deps}" "${bad}" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "agentos-shell links ${bad}:\n${deps}")
  endif()
endforeach()
string(FIND "${deps}" "Qt6Quick" q)
if(q EQUAL -1)
  message(FATAL_ERROR "expected a Qt Quick binary:\n${deps}")
endif()
file(READ "${CACHE}" cache)
foreach(bad Qt6WebEngine Qt6WebView Qt6WebEngineQuick)
  string(REGEX MATCH "${bad}_DIR:PATH=[^\n]*[^-]\n" hit "${cache}")
  if(hit AND NOT hit MATCHES "NOTFOUND")
    message(FATAL_ERROR "build configured ${bad}: ${hit}")
  endif()
endforeach()
message(STATUS "agentos-shell links no browser engine")
