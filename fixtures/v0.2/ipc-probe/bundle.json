        "type": "object",
        "required": [
          "ms"
        ],
        "properties": {
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    {
