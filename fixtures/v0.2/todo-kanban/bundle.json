{
  "formatVersion": 2,
  "manifest": {
    "appId": "9efaf674-4561-4c6b-9860-cf44e09fdd01",
    "title": "待办看板",
    "description": "按完成状态分列的看板，显示各优先级数量，支持批量完成。",
    "runtime": "isolated-code-v1",
    "capabilities": ["records.read", "records.write"]
  },
  "data": {
    "fields": {
      "title": { "type": "string", "label": "任务", "minLength": 1, "maxLength": 200 },
      "done": { "type": "boolean", "label": "已完成", "default": false },
      "priority": { "type": "enum", "label": "优先级", "values": ["low", "normal", "high"], "default": "normal" }
    }
  },
  "code": { "entry": "src/app.ts", "files": {} },
  "runtimeLockId": "core-v1@1",
  "queries": {
    "main": {
      "description": "看板数据和统计",
      "inputSchema": { "type": "object", "properties": {} },
      "outputSchema": {
        "type": "object",
        "required": ["items", "total", "open", "byPriority"],
        "properties": {
          "items": {
            "type": "array", "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["id", "title", "done", "priority", "priorityLabel"],
              "properties": {
                "id": { "type": "string", "maxLength": 64 },
                "title": { "type": "string", "maxLength": 200 },
                "done": { "type": "boolean" },
                "priority": { "type": "string", "enum": ["low", "normal", "high"] },
                "priorityLabel": { "type": "string", "maxLength": 8 }
              }
            }
          },
          "total": { "type": "integer", "minimum": 0 },
          "open": { "type": "integer", "minimum": 0 },
          "byPriority": {
            "type": "object", "required": ["high", "normal", "low"],
            "properties": { "high": { "type": "integer" }, "normal": { "type": "integer" }, "low": { "type": "integer" } }
          }
        }
      }
    }
  },
  "commands": {
    "add": {
      "description": "新建任务",
      "inputSchema": {
        "type": "object", "required": ["title"],
        "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "priority": { "type": "string", "enum": ["low", "normal", "high"] } }
      },
      "outputSchema": { "type": "object", "required": ["created"], "properties": { "created": { "type": "integer" } } },
      "operations": ["create"],
      "writableFields": ["title", "priority"]
    },
    "completeMany": {
      "description": "批量完成所选任务",
      "inputSchema": {
        "type": "object", "required": ["recordIds"],
        "properties": { "recordIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "maxLength": 64 } } }
      },
      "outputSchema": { "type": "object", "required": ["completed"], "properties": { "completed": { "type": "integer" } } },
      "operations": ["update"],
      "writableFields": ["done"]
    }
  },
  "exports": [],
  "imports": [],
  "view": {
    "kind": "slot-tree-v1",
    "dataSources": { "board": { "queryId": "main", "input": {} } },
    "slots": {
      "toolbar": {
        "type": "Stack", "props": { "direction": "horizontal", "gap": "sm" },
        "children": [
          { "type": "Button", "props": { "label": "批量完成", "command": "completeMany", "variant": "primary", "input": { "selection": { "selectionId": "picked", "as": "recordIds" } } } }
        ]
      },
      "main": {
        "type": "Stack", "props": { "gap": "md" },
        "children": [
          {
            "type": "Grid", "props": { "columns": 4, "gap": "sm" },
            "children": [
              { "type": "Metric", "props": { "label": "未完成", "value": { "$bind": { "from": "query", "source": "board", "pointer": "/open" } } } },
              { "type": "Metric", "props": { "label": "高优先级", "value": { "$bind": { "from": "query", "source": "board", "pointer": "/byPriority/high" } } } },
              { "type": "Metric", "props": { "label": "普通", "value": { "$bind": { "from": "query", "source": "board", "pointer": "/byPriority/normal" } } } },
              { "type": "Metric", "props": { "label": "低优先级", "value": { "$bind": { "from": "query", "source": "board", "pointer": "/byPriority/low" } } } }
            ]
          },
          {
            "type": "Kanban",
            "props": {
              "items": { "$bind": { "from": "query", "source": "board", "pointer": "/items" } },
              "groupPointer": "/done",
              "groups": [ { "value": false, "label": "未完成" }, { "value": true, "label": "已完成" } ],
              "cardTitlePointer": "/title",
              "cardFields": [ { "pointer": "/priorityLabel", "label": "优先级" } ],
              "rowId": "/id",
              "selectionId": "picked"
            }
          },
          {
            "type": "Form", "props": { "formId": "newTask", "title": "新建任务" },
            "children": [
              { "type": "TextInput", "props": { "name": "title", "label": "任务", "required": true, "maxLength": 200 } },
              { "type": "Select", "props": { "name": "priority", "label": "优先级", "options": [ { "value": "high", "label": "高" }, { "value": "normal", "label": "普通" }, { "value": "low", "label": "低" } ] } },
              { "type": "Button", "props": { "label": "添加", "command": "add", "input": { "form": "newTask" } } }
            ]
          }
        ]
      }
    }
  }
}
