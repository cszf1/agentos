# AgentOS v0.1 host configuration (copy to ~/.config/agentos/agentos.env, chmod 600)
AGENTOS_DATA_DIR=~/.local/share/agentos
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=4317
# real | faux. Unset provider/model => modelAvailable=false (apps still work).
AGENTOS_MODEL_MODE=real
# v0.1 enables only the validated real provider "openai-compatible" (any OpenAI Chat Completions endpoint over SSE).
AGENTOS_MODEL_PROVIDER=
AGENTOS_MODEL_ID=
# Only for AGENTOS_MODEL_PROVIDER=openai-compatible:
AGENTOS_MODEL_BASE_URL=
# API key for the endpoint (keep this file 0600; never commit it). pi-ai's official OPENAI_API_KEY also works.
AGENTOS_MODEL_API_KEY=
AGENTOS_LOG_LEVEL=info
