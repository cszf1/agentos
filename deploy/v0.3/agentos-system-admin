#!/usr/bin/env bash
# agentos-system-admin (v0.3 profile) — kept so v0.3 commands and docs keep working.
# There is ONE privileged installer, deploy/v0.4/agentos-system-admin; this runs it without the v0.4 additions
# (maintenance install caps, the test-only second demo unit). Same subcommands:
#   install   --host-user U --store-uuid S [--workspace-id W] [--build DIR] [--test-mode] [--serial-pty] [--serial-udev PATH:VID:PID:SERIAL]
#   inspect | reinstall-log | uninstall
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
AGENTOS_SYSADMIN_PROFILE=v0.3 exec bash "$here/../v0.4/agentos-system-admin" "$@"
