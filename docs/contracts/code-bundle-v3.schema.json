{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentos:code-bundle:v3",
  "title": "AgentOS isolated code application bundle v3 (system bindings and plans)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "manifest",
    "data",
    "code",
    "runtimeLockId",
    "queries",
    "commands",
    "exports",
    "imports",
    "system",
    "view"
  ],
  "properties": {
    "formatVersion": {
      "const": 3
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "title",
        "runtime",
        "capabilities"
      ],
      "properties": {
        "appId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "runtime": {
          "const": "isolated-code-v2"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "records.read",
              "records.write"
            ]
          },
          "contains": {
            "const": "records.read"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/fieldKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "files"
      ],
      "properties": {
        "entry": {
          "const": "src/app.ts"
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "runtimeLockId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}@[0-9]+$"
    },
    "queries": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/queryDeclV3"
      }
    },
    "commands": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/commandDecl"
      }
    },
    "exports": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exportName",
          "queryId",
          "contractVersion",
          "description"
        ],
        "properties": {
          "exportName": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "queryId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "contractVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "inputSchema",
          "outputSchema"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 256
          },
          "inputSchema": {},
          "outputSchema": {}
        }
      }
    },
    "view": {
      "type": "object"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindings",
        "actions"
      ],
      "properties": {
        "bindings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "resourceKind",
              "capabilities",
              "description"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "resourceKind": {
                "enum": [
                  "import-root",
                  "managed-root",
                  "service",
                  "lab-network",
                  "host-network",
                  "serial"
                ]
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "capabilityId",
                    "contractVersion"
                  ],
                  "properties": {
                    "capabilityId": {
                      "type": "string"
                    },
                    "contractVersion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                }
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "actions": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bindingAlias",
              "capabilityId",
              "contractVersion",
              "inputSchema",
              "previewSchema",
              "observations"
            ],
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 256
              },
              "bindingAlias": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "capabilityId": {
                "type": "string"
              },
              "contractVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "inputSchema": {},
              "previewSchema": {},
              "observations": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bindingAlias",
                    "capabilityId"
                  ],
                  "properties": {
                    "bindingAlias": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "capabilityId": {
                      "type": "string",
                      "pattern": "^[a-z]+\\.[a-z_]+$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fieldKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "fieldList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fieldKey"
      }
    },
    "field": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringField"
        },
        {
          "$ref": "#/$defs/booleanField"
        },
        {
          "$ref": "#/$defs/integerField"
        },
        {
          "$ref": "#/$defs/enumField"
        }
      ]
    },
    "stringField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "maxLength"
      ],
      "properties": {
        "type": {
          "const": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "default": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "booleanField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "integerField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "integer"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "minimum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "default": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "enumField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "values"
      ],
      "properties": {
        "type": {
          "const": "enum"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "default": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "queryDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "inputSchema": {},
        "outputSchema": {}
      }
    },
    "commandDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputSchema",
        "outputSchema",
        "operations",
        "writableFields"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "inputSchema": {},
        "outputSchema": {},
        "operations": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create",
              "update",
              "delete"
            ]
          }
        },
        "writableFields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldKey"
          }
        }
      }
    },
    "queryDeclV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "inputSchema": {},
        "outputSchema": {},
        "providerReads": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bindingAlias",
              "capabilityId"
            ],
            "properties": {
              "bindingAlias": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "capabilityId": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z_]+$"
              }
            }
          }
        }
      }
    }
  }
}
